[Unit]
Description=Home Automation Controller V4m (plaintext + SQLite)
After=rabbitmq-server.service
Wants=rabbitmq-server.service

[Service]
Type=simple
ExecStart=/root/controller-v4m -period-ms 1000 -db /var/lib/homeautomation/v4m.db -http-port 8081
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
