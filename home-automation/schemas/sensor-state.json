{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/home-automation/schemas/sensor-state.json",
  "title": "SensorState",
  "allOf": [
    { "$ref": "base-state.json" },
    {
      "type": "object",
      "properties": {
        "device_kind": { "const": "sensor" },
        "digital_value": {
          "type": "array",
          "items": { "type": "integer", "enum": [0, 1] },
          "description": "Positional digital channels (index meaning defined by device_type registry)."
        },
        "analog_value": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Positional analog channels."
        }
      }
    }
  ],
  "description": "digital_value and analog_value are optional and independently present."
}
