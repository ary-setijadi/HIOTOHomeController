{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/home-automation/schemas/monitor-state.json",
  "title": "MonitorState",
  "allOf": [
    { "$ref": "base-state.json" },
    {
      "type": "object",
      "properties": {
        "device_kind": { "const": "monitor" },
        "view_scope": {
          "type": "string",
          "description": "all | room:<name> | device_kind:<kind>"
        },
        "subscribed_topics": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Read-only wildcard subscriptions."
        }
      }
    }
  ]
}
